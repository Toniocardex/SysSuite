<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Identita' progetto -->
    <AssemblyName>SysSuite</AssemblyName>
    <RootNamespace>SysSuite</RootNamespace>
    <Product>SysSuite One</Product>
    <Company>Antonio Cardelli</Company>
    <Authors>Antonio Cardelli</Authors>
    <Copyright>Copyright 2025 Antonio Cardelli - Licenza MIT</Copyright>
    <Description>Suite completa di ottimizzazione, manutenzione e sicurezza per Windows 10/11</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- WinUI 3 + Windows App SDK -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SysSuite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Cartella unpackaged (dotnet publish); obbligatorio per WinUI 3, non MSIX singolo da csproj -->
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      dotnet / MSBuild Core non imposta sempre WindowsSdkPath (il fallback registry in interop.targets
      vale solo per MSBuild "Full"). Ordine: variabile d'ambiente WindowsSdkDir, registro KitsRoot10,
      cartelle standard con Platforms.xml.
    -->
    <WindowsSdkPath Condition="'$(WindowsSdkPath)' == '' and '$(WindowsSdkDir)' != ''">$([MSBuild]::EnsureTrailingSlash('$(WindowsSdkDir)'))</WindowsSdkPath>
    <_KitsRoot10FromReg>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', '', RegistryView.Registry64, RegistryView.Registry32, RegistryView.Default))</_KitsRoot10FromReg>
    <WindowsSdkPath Condition="'$(WindowsSdkPath)' == '' and '$(_KitsRoot10FromReg)' != ''">$([MSBuild]::EnsureTrailingSlash($(_KitsRoot10FromReg)))</WindowsSdkPath>
    <_Win10SdkInstallFolder>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\Microsoft SDKs\Windows\v10.0', 'InstallationFolder', '', RegistryView.Registry32, RegistryView.Default))</_Win10SdkInstallFolder>
    <WindowsSdkPath Condition="'$(WindowsSdkPath)' == '' and '$(_Win10SdkInstallFolder)' != '' and Exists('$(_Win10SdkInstallFolder)UnionMetadata')">$([MSBuild]::EnsureTrailingSlash($(_Win10SdkInstallFolder)))</WindowsSdkPath>
    <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == '' and Exists('$(MSBuildProgramFiles32)Windows Kits\10\Platforms.xml')">$([MSBuild]::NormalizeDirectory('$(MSBuildProgramFiles32)'))Windows Kits\10\</WindowsKitsRoot>
    <WindowsKitsRoot Condition="'$(WindowsKitsRoot)' == '' and Exists('$(ProgramFiles)\Windows Kits\10\Platforms.xml')">$([MSBuild]::NormalizeDirectory('$(ProgramFiles)'))Windows Kits\10\</WindowsKitsRoot>
    <WindowsSdkPath Condition="'$(WindowsSdkPath)' == '' and '$(WindowsKitsRoot)' != ''">$(WindowsKitsRoot)</WindowsSdkPath>

    <!-- Publish: da riga di comando usare self-contained e WindowsAppSDKSelfContained (vedi COMPILA_E_FIRMA.bat) -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <!--
      Limita le cartelle lingua .NET a: it-IT, fr-FR, de-DE, es-ES, da-DK.
      NOTA: Windows App SDK ignora questa proprieta' per le sue risorse WinRT.
      Il target RemoveUnwantedLanguageFolders (in fondo al file) cancella le
      cartelle rimaste dopo il publish.
      Senza questa riga il publish copia le risorse di WinUI 3 per tutte
      le 50+ lingue supportate (~20 MB di cartelle inutili per l'utente finale).
      Aggiungi altre lingue separate da ; se necessario.
    -->
    <SatelliteResourceLanguages>it-IT;en-US;fr-FR;de-DE;es-ES;da-DK</SatelliteResourceLanguages>

    <!--
      Esclude i file .pdb (simboli di debug) dalla cartella dist finale.
      I .pdb non servono all'utente finale e possono esporre la struttura
      interna del codice. Rimuovi questa riga solo se hai bisogno di
      analizzare crash dump in produzione.
    -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Pacchetti NuGet: solo cio' che serve alla build (vedi nota sotto) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- WMI usato da SystemInfo, BatteryService, DiskAnalyzer, DriverService -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- LiveCharts2: grafici professionali (donut, line, area) per WinUI 3 -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc4.5" />
    <!-- Logging strutturato su file (rotazione giornaliera) -->
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!-- XAML inclusi automaticamente da SDK e WinUI: non ripetere Page qui (NETSDK1022) -->

  <!--
    Target post-publish: rimuove le cartelle lingua di Windows App SDK non volute.
    SatelliteResourceLanguages non e' sufficiente perche' le risorse WinRT
    (file .pri) vengono copiate da un meccanismo separato di Windows App SDK.
    Lingue mantenute: it-IT  en-US  fr-FR  de-DE  es-ES  da-DK
  -->
  <Target Name="RemoveUnwantedLanguageFolders" AfterTargets="Publish">
    <ItemGroup>
      <_LangDirs Include="$(PublishDir)*/"/>
    </ItemGroup>
    <RemoveDir
      Directories="%(_LangDirs.FullPath)"
      Condition="
        '%(Filename)' != 'it-IT' And
        '%(Filename)' != 'en-US' And
        '%(Filename)' != 'fr-FR' And
        '%(Filename)' != 'de-DE' And
        '%(Filename)' != 'es-ES' And
        '%(Filename)' != 'da-DK'" />
    <Message Text="Lingua rimossa dalla dist: %(_LangDirs.Filename)" Importance="normal"
      Condition="
        '%(Filename)' != 'it-IT' And
        '%(Filename)' != 'en-US' And
        '%(Filename)' != 'fr-FR' And
        '%(Filename)' != 'de-DE' And
        '%(Filename)' != 'es-ES' And
        '%(Filename)' != 'da-DK'" />
  </Target>

</Project>