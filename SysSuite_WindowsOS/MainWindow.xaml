<Window
    x:Class="SysSuite.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SysSuite One">

    <!--
        NOTA: Tutti i colori inline qui rispecchiano le risorse definite in App.xaml.
              In caso di cambio palette, aggiornare App.xaml — MainWindow si aggiorna
              automaticamente ovunque si usino StaticResource / ThemeResource.

        FONT ICONE: Usa "Segoe Fluent Icons" (Windows 11) oppure "Segoe MDL2 Assets"
                    (Windows 10 compat). Le stringhe Glyph sotto usano Segoe Fluent Icons.
    -->

    <Grid Background="#07090F">
        <Grid.ColumnDefinitions>
            <!-- Sidebar fissa -->
            <ColumnDefinition Width="230"/>
            <!-- Separatore sottile 1px -->
            <ColumnDefinition Width="1"/>
            <!-- Area contenuto -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#0C0F1C">
            <Grid.RowDefinitions>
                <!-- Brand area -->
                <RowDefinition Height="Auto"/>
                <!-- Divider -->
                <RowDefinition Height="1"/>
                <!-- Nav list -->
                <RowDefinition Height="*"/>
                <!-- Divider -->
                <RowDefinition Height="1"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Brand / Logo ── -->
            <Border Grid.Row="0" Padding="18,20,18,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icona logo (PNG 512 px in Assets/Brand, da master ad alta risoluzione) -->
                    <Border
                        Grid.Column="0"
                        Width="34" Height="34"
                        CornerRadius="8"
                        Background="#00D4A018"
                        BorderBrush="#00D4A040"
                        BorderThickness="1">
                        <Image
                            Source="ms-appx:///Assets/Brand/Logo512.png"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"/>
                    </Border>

                    <!-- Nome app -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="SysSuite"
                            FontFamily="Consolas"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#ECF0F8"/>
                        <TextBlock
                            Text="ONE"
                            FontFamily="Consolas"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="#00D4A0"
                            CharacterSpacing="250"/>
                    </StackPanel>

                    <!-- Indicatore stato sistema (puntino verde = ok) -->
                    <Ellipse
                        Grid.Column="2"
                        Width="7" Height="7"
                        Fill="#34D399"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Sistema operativo"/>
                </Grid>
            </Border>

            <!-- Divisore brand / nav -->
            <Border Grid.Row="1" Background="#151C30"/>

            <!-- ── Navigation List ── -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <StackPanel Padding="10,12,10,8">

                    <!-- Label sezione principale -->
                    <TextBlock
                        Text="PRINCIPALE"
                        FontFamily="Consolas"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="#3D4D66"
                        CharacterSpacing="180"
                        Margin="8,4,0,8"/>

                    <ListView
                        x:Name="NavList"
                        SelectionMode="Single"
                        SelectionChanged="NavList_SelectionChanged"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListView.Resources>
                            <!-- Sopprime il rettangolo di selezione blu WinUI3 default -->
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected"             Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedUnfocused"    Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"  Color="#0D00D4A0"/>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"          Color="#141828"/>
                            <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush"        Color="Transparent"/>
                            <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush"      Color="Transparent"/>
                        </ListView.Resources>

                        <!-- DASHBOARD -->
                        <ListViewItem Tag="Hub" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE80F;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Dashboard"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- OTTIMIZZAZIONE -->
                        <ListViewItem Tag="MainSuite" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE945;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Ottimizzazione"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- MONITOR LIVE -->
                        <ListViewItem Tag="Monitor" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE9D9;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Monitor Live"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                                <!-- Badge "LIVE" (stesso accento del pulsante primario / Aggiorna) -->
                                <Border
                                    Style="{StaticResource SysBadgeAccent}"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="LIVE"
                                        FontFamily="Consolas"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SysAccentBrush}"
                                        CharacterSpacing="100"/>
                                </Border>
                            </StackPanel>
                        </ListViewItem>

                        <!-- Divisore sezione -->
                        <ListViewItem IsHitTestVisible="False" Padding="0" Margin="0,4">
                            <Border Background="#151C30" Height="1" HorizontalAlignment="Stretch" Margin="0"/>
                        </ListViewItem>

                        <!-- Label sezione STORAGE -->
                        <ListViewItem IsHitTestVisible="False" Padding="8,0" Margin="0,4,0,2">
                            <TextBlock
                                Text="STORAGE &amp; PROCESSI"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#3D4D66"
                                CharacterSpacing="180"/>
                        </ListViewItem>

                        <!-- ANALISI DISCO -->
                        <ListViewItem Tag="Disco" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xEDA2;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Analisi Disco"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- PROCESSI E APP -->
                        <ListViewItem Tag="AppManager" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE74C;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Processi e App"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- Divisore sezione -->
                        <ListViewItem IsHitTestVisible="False" Padding="0" Margin="0,4">
                            <Border Background="#151C30" Height="1" HorizontalAlignment="Stretch"/>
                        </ListViewItem>

                        <!-- Label sezione STRUMENTI -->
                        <ListViewItem IsHitTestVisible="False" Padding="8,0" Margin="0,4,0,2">
                            <TextBlock
                                Text="STRUMENTI"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#3D4D66"
                                CharacterSpacing="180"/>
                        </ListViewItem>

                        <!-- GAMING MODE -->
                        <ListViewItem Tag="Gaming" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE7FC;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Gaming Mode"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- SCANNER RETE -->
                        <ListViewItem Tag="Network" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE968;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Scanner Rete"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- DRIVER -->
                        <ListViewItem Tag="Driver" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE9F5;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Driver"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- Divisore sezione -->
                        <ListViewItem IsHitTestVisible="False" Padding="0" Margin="0,4">
                            <Border Background="#151C30" Height="1" HorizontalAlignment="Stretch"/>
                        </ListViewItem>

                        <!-- Label sezione MANUTENZIONE -->
                        <ListViewItem IsHitTestVisible="False" Padding="8,0" Margin="0,4,0,2">
                            <TextBlock
                                Text="MANUTENZIONE"
                                FontFamily="Consolas"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#3D4D66"
                                CharacterSpacing="180"/>
                        </ListViewItem>

                        <!-- BATTERIA -->
                        <ListViewItem Tag="Battery" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE83F;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Batteria"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- PULIZIA BROWSER -->
                        <ListViewItem Tag="Browser" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xF6FA;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Pulizia Browser"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- REGISTRO -->
                        <ListViewItem Tag="Registry" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE8A5;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Registro"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                        <!-- IMPOSTAZIONI -->
                        <ListViewItem Tag="Settings" Padding="8,0" Margin="0,1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,9">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE713;"
                                    FontSize="15"
                                    Foreground="#7A8BA8"/>
                                <TextBlock
                                    Text="Impostazioni"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#B0BAD0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListViewItem>

                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- Divisore footer -->
            <Border Grid.Row="3" Background="#151C30"/>

            <!-- ── Sidebar Footer ── -->
            <Border Grid.Row="4" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TxtVersion"
                            Text="v1.0.0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#3D4D66"/>
                        <TextBlock
                            x:Name="TxtBuildDate"
                            Text="build 2025.04"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#28334A"
                            Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Pulsante impostazioni -->
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource SysButtonIcon}"
                        ToolTipService.ToolTip="Impostazioni"
                        Click="BtnSettings_Click">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE713;"
                            FontSize="15"
                            Foreground="#3D4D66"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Separatore verticale sidebar / contenuto ── -->
        <Border Grid.Column="1" Background="#151C30"/>

        <!-- ══════════════════════════════════════════
             AREA CONTENUTO
             ══════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- Topbar header -->
                <RowDefinition Height="Auto"/>
                <!-- Divisore -->
                <RowDefinition Height="1"/>
                <!-- Frame pagina -->
                <RowDefinition Height="*"/>
                <!-- Divisore -->
                <RowDefinition Height="1"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Topbar ── -->
            <Border Grid.Row="0" Padding="24,0" Background="#0C0F1C" Height="56">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titolo sezione corrente + breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Breadcrumb opzionale: "SysSuite /" -->
                        <TextBlock
                            Text="SysSuite /"
                            FontFamily="Consolas"
                            FontSize="13"
                            Foreground="#3D4D66"
                            VerticalAlignment="Center"/>
                        <!-- Nome sezione (aggiornato da codice su NavList_SelectionChanged) -->
                        <TextBlock
                            x:Name="TxtTitle"
                            Text="Dashboard"
                            FontFamily="Consolas"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#ECF0F8"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Metriche real-time + orologio -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                        <!-- CPU Badge -->
                        <Border
                            Background="#1E253C"
                            BorderBrush="#1E2A42"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE950;"
                                    FontSize="11"
                                    Foreground="#3D4D66"/>
                                <TextBlock
                                    Text="CPU"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#3D4D66"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="TxtCPU"
                                    Text="—"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#00D4A0"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM Badge -->
                        <Border
                            Background="#1E253C"
                            BorderBrush="#1E2A42"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE7F4;"
                                    FontSize="11"
                                    Foreground="#3D4D66"/>
                                <TextBlock
                                    Text="RAM"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#3D4D66"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="TxtRAM"
                                    Text="—"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#3B9EFF"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DISK Badge -->
                        <Border
                            Background="#1E253C"
                            BorderBrush="#1E2A42"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xEDA2;"
                                    FontSize="11"
                                    Foreground="#3D4D66"/>
                                <TextBlock
                                    Text="DSK"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#3D4D66"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="TxtDisk"
                                    Text="—"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB547"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Health Score badge -->
                        <Border
                            x:Name="BadgeHealth"
                            Background="#1E253C"
                            BorderBrush="#1E2A42"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,5">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock
                                    Text="&#xE8C8;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="11"
                                    Foreground="#3D4D66"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    x:Name="TxtHealth"
                                    Text="—"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#34D399"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Divisore verticale -->
                        <Border
                            Width="1"
                            Background="#1E2A42"
                            Margin="4,10"/>

                        <!-- Orologio -->
                        <TextBlock
                            x:Name="TxtTime"
                            Text="00:00:00"
                            FontFamily="Consolas"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#3D4D66"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Divisore topbar / contenuto -->
            <Border Grid.Row="1" Background="#151C30"/>

            <!-- ── Frame pagina ── -->
            <Frame
                x:Name="ContentFrame"
                Grid.Row="2"
                Background="#07090F"/>

            <!-- Divisore contenuto / status bar -->
            <Border Grid.Row="3" Background="#151C30"/>

            <!-- ── Status Bar ── -->
            <Border Grid.Row="4" Background="#0C0F1C" Padding="20,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Messaggio stato corrente (aggiornato da codice) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#34D399"/>
                        <TextBlock
                            x:Name="TxtStatus"
                            Text="Sistema pronto"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#3D4D66"/>
                    </StackPanel>

                    <!-- Info destra: badge admin + uptime + hostname -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                        <!-- Badge ADMIN — visibile solo se NON admin -->
                        <Border
                            x:Name="BannerNotAdmin"
                            Background="#FFB54718"
                            BorderBrush="#FFB547"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    Text="&#xE8D7;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="11"
                                    Foreground="#FFB547"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    Text="Non admin"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#FFB547"
                                    VerticalAlignment="Center"/>
                                <Button
                                    x:Name="BtnRelaunchAdmin"
                                    Content="Riavvia come Admin"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="#FFB54730"
                                    BorderBrush="#FFB547"
                                    BorderThickness="1"
                                    Foreground="#FFB547"
                                    Click="BtnRelaunchAdmin_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Badge ADMIN — visibile solo se admin -->
                        <Border
                            x:Name="BannerIsAdmin"
                            Background="#34D39918"
                            BorderBrush="#34D399"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,3"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="&#xE8D7;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="11"
                                    Foreground="#34D399"
                                    VerticalAlignment="Center"/>
                                <TextBlock
                                    Text="Amministratore"
                                    FontFamily="Consolas"
                                    FontSize="10"
                                    Foreground="#34D399"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            x:Name="TxtUptime"
                            Text="Uptime: —"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#28334A"/>
                        <TextBlock
                            x:Name="TxtHostname"
                            Text="—"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="#28334A"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
