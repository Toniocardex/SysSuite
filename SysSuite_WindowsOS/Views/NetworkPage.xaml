<Page
    x:Class="SysSuite.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Scanner Rete" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Ottimizza DNS, TCP/IP, misura la velocità e scansiona le porte aperte." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <!-- IP Pubblico + Speed Test affiancati -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IP Pubblico -->
            <Border Grid.Column="0" Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="16"
                            Foreground="#00D4A0" VerticalAlignment="Center"/>
                        <TextBlock Text="IL TUO IP PUBBLICO" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPublicIp" Text="—" FontFamily="Consolas" FontSize="20"
                        FontWeight="Bold" Foreground="#00D4A0"/>
                    <TextBlock x:Name="TxtIpIsp" Text="" FontFamily="Consolas" FontSize="11" Foreground="#7A8BA8"/>
                    <TextBlock x:Name="TxtIpLocation" Text="" FontFamily="Consolas" FontSize="11" Foreground="#3D4D66"/>
                    <Button x:Name="BtnCheckIp" Content="Rileva IP pubblico" Style="{StaticResource SysButtonSecondary}"
                        Click="BtnCheckIp_Click"
                        ToolTipService.ToolTip="Interroga un servizio esterno per mostrare il tuo indirizzo IP pubblico, ISP e posizione approssimativa."/>
                </StackPanel>
            </Border>

            <!-- Speed Test -->
            <Border Grid.Column="2" Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="16"
                            Foreground="#3B9EFF" VerticalAlignment="Center"/>
                        <TextBlock Text="SPEED TEST" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSpeedResult" Text="—" FontFamily="Consolas" FontSize="20"
                        FontWeight="Bold" Foreground="#3B9EFF"/>
                    <TextBlock x:Name="TxtSpeedDetail" Text="Scarica ~10 MB da Cloudflare per misurare la banda."
                        FontFamily="Consolas" FontSize="11" Foreground="#3D4D66" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnSpeedTest" Content="Avvia Speed Test" Style="{StaticResource SysButtonPrimary}"
                            Click="BtnSpeedTest_Click"
                            ToolTipService.ToolTip="Scarica ~10 MB da un server Cloudflare e calcola la velocità media in download. Non richiede admin."/>
                        <ProgressBar x:Name="PbSpeed" Style="{StaticResource SysProgressBar}" Width="120"
                            VerticalAlignment="Center" IsIndeterminate="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Azioni rapide DNS / TCP -->
        <Border Grid.Row="2" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <TextBlock Text="OTTIMIZZAZIONE RETE" Style="{StaticResource SysHeading3}"/>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Svuota DNS" Style="{StaticResource SysButtonSecondary}" Click="BtnFlushDNS_Click"/>
                        <Button Content="Reset TCP/IP" Style="{StaticResource SysButtonSecondary}" Click="BtnResetTCP_Click"/>
                        <Button Content="Reset Winsock" Style="{StaticResource SysButtonSecondary}" Click="BtnResetWinsock_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="DNS Google (8.8.8.8)" Style="{StaticResource SysButtonSecondary}" Click="BtnDNSGoogle_Click"/>
                        <Button Content="DNS Cloudflare (1.1.1.1)" Style="{StaticResource SysButtonSecondary}" Click="BtnDNSCF_Click"/>
                        <Button Content="Nagle OFF (gaming)" Style="{StaticResource SysButtonSecondary}" Click="BtnNagleOff_Click"/>
                        <Button Content="Ripristina Nagle" Style="{StaticResource SysButtonSecondary}" Click="BtnNagleRestore_Click"/>
                        <Button Content="DNS automatico (DHCP)" Style="{StaticResource SysButtonSecondary}" Click="BtnDNSDHCP_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tool Ping -->
        <Border Grid.Row="3" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <TextBlock Text="TOOL PING" Style="{StaticResource SysHeading3}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TxtPingHost" PlaceholderText="Host o IP (es. 8.8.8.8)"
                        Style="{StaticResource SysTextBox}" Width="240"/>
                    <Button Content="Ping" Style="{StaticResource SysButtonPrimary}" Click="BtnPing_Click"/>
                    <TextBlock x:Name="TxtPingResult" FontFamily="Consolas" FontSize="13"
                        Foreground="#00D4A0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Scanner porte -->
        <Border Grid.Row="4" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <TextBlock Text="SCANNER PORTE" Style="{StaticResource SysHeading3}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Avvia scansione" Style="{StaticResource SysButtonPrimary}" Click="BtnScan_Click"/>
                    <ProgressBar x:Name="PbScan" Style="{StaticResource SysProgressBar}" Width="200" VerticalAlignment="Center" Maximum="100"/>
                    <TextBlock x:Name="TxtScanStatus" Text="" Style="{StaticResource SysCaption}" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="LvPorts" MaxHeight="140" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,4">
                                <TextBlock Text="{Binding Port}" FontFamily="Consolas" FontSize="12" Foreground="#00D4A0" Width="60"/>
                                <TextBlock Text="{Binding State}" FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8" Width="80"/>
                                <TextBlock Text="{Binding LocalAddr}" FontFamily="Consolas" FontSize="12" Foreground="#ECF0F8"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="5" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="LOG" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Pulisci" Style="{StaticResource SysButtonGhost}" Click="BtnClear_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>