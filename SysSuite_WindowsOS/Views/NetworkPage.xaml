<Page
    x:Class="SysSuite.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Scanner Rete" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Ottimizza DNS, TCP/IP, misura la velocità e scansiona le porte aperte." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="16"
                            Foreground="#00D4A0" VerticalAlignment="Center"/>
                        <TextBlock Text="IL TUO IP PUBBLICO" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PublicIpText}" FontFamily="Consolas" FontSize="20"
                        FontWeight="Bold" Foreground="#00D4A0"/>
                    <TextBlock Text="{Binding IpIspText}" FontFamily="Consolas" FontSize="11" Foreground="#7A8BA8"/>
                    <TextBlock Text="{Binding IpLocationText}" FontFamily="Consolas" FontSize="11" Foreground="#3D4D66"/>
                    <Button Content="Rileva IP pubblico" Style="{StaticResource SysButtonSecondary}"
                        Command="{Binding CheckPublicIpCommand}"
                        IsEnabled="{Binding IsCheckIpButtonEnabled}"
                        ToolTipService.ToolTip="Interroga un servizio esterno per mostrare il tuo indirizzo IP pubblico, ISP e posizione approssimativa."/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="16"
                            Foreground="#3B9EFF" VerticalAlignment="Center"/>
                        <TextBlock Text="SPEED TEST" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SpeedResultText}" FontFamily="Consolas" FontSize="20"
                        FontWeight="Bold" Foreground="{Binding SpeedResultBrush}"/>
                    <TextBlock Text="{Binding SpeedDetailText}"
                        FontFamily="Consolas" FontSize="11" Foreground="#3D4D66" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Avvia Speed Test" Style="{StaticResource SysButtonPrimary}"
                            Command="{Binding SpeedTestCommand}"
                            IsEnabled="{Binding IsSpeedTestButtonEnabled}"
                            ToolTipService.ToolTip="Scarica ~10 MB da un server Cloudflare e calcola la velocità media in download. Non richiede admin."/>
                        <ProgressBar Style="{StaticResource SysProgressBar}" Width="120"
                            VerticalAlignment="Center" IsIndeterminate="{Binding IsSpeedTestBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="OTTIMIZZAZIONE RETE" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                        IsActive="{Binding IsNetworkOptBusy}"
                        Visibility="{Binding NetworkOptRingVisibility}"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Ottimizza" Style="{StaticResource SysButtonPrimary}"
                            Command="{Binding OptimizeNetworkCommand}"
                            IsEnabled="{Binding AreNetworkOptButtonsEnabled}"
                            ToolTipService.ToolTip="Network Booster: punto di ripristino, Nagle/Delayed ACK, MSMQ TCPNoDelay, flush DNS (richiede Admin)."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Svuota DNS" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding FlushDnsCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="Reset TCP/IP" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding ResetTcpCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="Reset Winsock" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding ResetWinsockCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="DNS Google (8.8.8.8)" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding DnsGoogleCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="DNS Cloudflare (1.1.1.1)" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding DnsCloudflareCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="Nagle OFF (gaming)" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding NagleOffCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="Ripristina Nagle" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding NagleRestoreCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                        <Button Content="DNS automatico (DHCP)" Style="{StaticResource SysButtonSecondary}"
                            Command="{Binding DnsDhcpCommand}" IsEnabled="{Binding AreNetworkOptButtonsEnabled}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <TextBlock Text="TOOL PING" Style="{StaticResource SysHeading3}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox PlaceholderText="Host o IP (es. 8.8.8.8)"
                        Style="{StaticResource SysTextBox}" Width="240"
                        Text="{Binding PingHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Ping" Style="{StaticResource SysButtonPrimary}"
                        Command="{Binding PingCommand}" IsEnabled="{Binding IsPingButtonEnabled}"/>
                    <ProgressRing Width="20" Height="20" VerticalAlignment="Center"
                        IsActive="{Binding IsPingBusy}" Visibility="{Binding PingRingVisibility}"/>
                    <TextBlock Text="{Binding PingResultText}" FontFamily="Consolas" FontSize="13"
                        Foreground="{Binding PingResultBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <TextBlock Text="SCANNER PORTE" Style="{StaticResource SysHeading3}"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Avvia scansione" Style="{StaticResource SysButtonPrimary}"
                        Command="{Binding ScanPortsCommand}" IsEnabled="{Binding IsScanButtonEnabled}"/>
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                        IsActive="{Binding IsScanBusy}" Visibility="{Binding ScanRingVisibility}"/>
                    <ProgressBar Style="{StaticResource SysProgressBar}" Width="200" VerticalAlignment="Center"
                        Maximum="100" Value="{Binding ScanProgress, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ScanStatusText}" Style="{StaticResource SysCaption}" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView ItemsSource="{Binding PortEntries}" MaxHeight="140" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,4">
                                <TextBlock Text="{Binding Port}" FontFamily="Consolas" FontSize="12" Foreground="#00D4A0" Width="60"/>
                                <TextBlock Text="{Binding State}" FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8" Width="80"/>
                                <TextBlock Text="{Binding LocalAddr}" FontFamily="Consolas" FontSize="12" Foreground="#ECF0F8"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="LOG" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Pulisci" Style="{StaticResource SysButtonGhost}" Command="{Binding ClearLogCommand}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="Transparent">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copia log" Click="LogCopyMenu_Click">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Copy"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8" TextWrapping="Wrap"
                            Text="{Binding LogText}" IsTextSelectionEnabled="True"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
