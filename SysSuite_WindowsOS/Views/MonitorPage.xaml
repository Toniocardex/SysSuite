<Page
    x:Class="SysSuite.Views.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:models="using:SysSuite.Models"
    xmlns:local="using:SysSuite.Views"
    x:DataType="local:MonitorPage"
    Background="{StaticResource SysBGBrush}"
    Loaded="MonitorPage_Loaded"
    Unloaded="MonitorPage_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Monitor Live" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Processi in esecuzione ordinati per utilizzo RAM." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Aggiorna" Style="{StaticResource SysButtonPrimary}"
                    Command="{x:Bind ViewModel.RefreshCommand}"/>
                <Button Content="Termina processo" Style="{StaticResource SysButtonDanger}"
                    Command="{x:Bind ViewModel.KillSelectedCommand}"/>
                <TextBox PlaceholderText="Filtra per nome..."
                    Style="{StaticResource SysTextBox}" Width="200"
                    Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}"
                    Style="{StaticResource SysCaption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SysCard}" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="CPU / RAM — ultimi 60 secondi"
                            Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#00D4A0" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" FontFamily="Consolas" FontSize="10"
                                Foreground="#00D4A0" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#3B9EFF"
                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="RAM" FontFamily="Consolas" FontSize="10"
                                Foreground="#3B9EFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LiveCpuText, Mode=OneWay}"
                            FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                            Foreground="#00D4A0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.LiveRamText, Mode=OneWay}"
                            FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                            Foreground="#3B9EFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <lvc:CartesianChart
                        Series="{x:Bind ViewModel.ChartSeries, Mode=OneWay}"
                        XAxes="{x:Bind ViewModel.ChartXAxes, Mode=OneWay}"
                        YAxes="{x:Bind ViewModel.ChartYAxes, Mode=OneWay}"
                        Height="120"
                        Background="Transparent"
                        AnimationsSpeed="0:0:0.200"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SysCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/><ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="PID" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="PID"/>
                        <Button Grid.Column="1" Content="NOME" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Name"/>
                        <Button Grid.Column="2" Content="CPU %" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="CpuPercent"/>
                        <Button Grid.Column="3" Content="RAM (MB)" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="RamMB"/>
                        <Button Grid.Column="4" Content="THREAD" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Command="{x:Bind ViewModel.SortByColumnCommand}" CommandParameter="Threads"/>
                        <TextBlock Grid.Column="5" Text="STATO" Style="{StaticResource SysHeading3}"/>
                    </Grid>
                    <ListView Grid.Row="1" Background="Transparent" BorderThickness="0"
                        ItemsSource="{x:Bind ViewModel.ProcessItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProcessEntry">
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/><ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind PID, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#3D4D66"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#ECF0F8"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CpuStr, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12"
                                        Foreground="{x:Bind CpuForeground, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RamMB, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#3B9EFF"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Threads, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind RespondingText, Mode=OneWay}"
                                        FontFamily="Consolas" FontSize="12"
                                        Foreground="{x:Bind RespondingForeground, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
