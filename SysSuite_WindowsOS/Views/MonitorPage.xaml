<Page
    x:Class="SysSuite.Views.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Monitor Live" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Processi in esecuzione ordinati per utilizzo RAM." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Aggiorna" Style="{StaticResource SysButtonPrimary}" Click="BtnRefresh_Click"/>
                <Button Content="Termina processo" Style="{StaticResource SysButtonDanger}" Click="BtnKill_Click"/>
                <TextBox x:Name="TxtFilter" PlaceholderText="Filtra per nome..."
                    Style="{StaticResource SysTextBox}" Width="200" TextChanged="TxtFilter_Changed"/>
                <TextBlock x:Name="TxtCount" Text="" Style="{StaticResource SysCaption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Grafico CPU/RAM — LiveCharts2 CartesianChart -->
            <Border Grid.Row="0" Style="{StaticResource SysCard}" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="CPU / RAM — ultimi 60 secondi"
                            Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#00D4A0" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU" FontFamily="Consolas" FontSize="10"
                                Foreground="#00D4A0" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="#3B9EFF"
                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="RAM" FontFamily="Consolas" FontSize="10"
                                Foreground="#3B9EFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Valori live -->
                        <TextBlock x:Name="TxtLiveCPU" Text=""
                            FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                            Foreground="#00D4A0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLiveRAM" Text=""
                            FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                            Foreground="#3B9EFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- CartesianChart LiveCharts2 -->
                    <lvc:CartesianChart
                        x:Name="ChartCpuRam"
                        Height="120"
                        Background="Transparent"/>
                </StackPanel>
            </Border>

            <!-- Lista processi -->
            <Border Grid.Row="1" Style="{StaticResource SysCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/><ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="PID" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Tag="PID" Click="BtnSortCol_Click"/>
                        <Button Grid.Column="1" Content="NOME" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Tag="Name" Click="BtnSortCol_Click"/>
                        <Button Grid.Column="2" Content="CPU %" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Tag="CpuPercent" Click="BtnSortCol_Click"/>
                        <Button Grid.Column="3" Content="RAM (MB)" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Tag="RamMB" Click="BtnSortCol_Click"/>
                        <Button Grid.Column="4" Content="THREAD" Style="{StaticResource SysButtonGhost}"
                            Padding="0" Tag="Threads" Click="BtnSortCol_Click"/>
                        <TextBlock Grid.Column="5" Text="STATO" Style="{StaticResource SysHeading3}"/>
                    </Grid>
                    <ListView x:Name="LvProc" Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="55"/><ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PID}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#3D4D66"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#ECF0F8"
                                        TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CpuStr}"
                                        FontFamily="Consolas" FontSize="12"
                                        Foreground="{Binding CpuColor}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RamMB}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#3B9EFF"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Threads}"
                                        FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8"/>
                                    <TextBlock Grid.Column="5" Text="{Binding RespondingText}"
                                        FontFamily="Consolas" FontSize="12"
                                        Foreground="{Binding RespondingColor}"/>
                                </Grid>
                                </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>