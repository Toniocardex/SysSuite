<Page
    x:Class="SysSuite.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Brand/Logo256.png" Width="40" Height="40"
                    Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Impostazioni" Style="{StaticResource SysHeading1}"/>
                    <TextBlock Text="Comportamento, notifiche proattive, One-Click Boost e dati locali."
                        Style="{StaticResource SysBodyText}"/>
                </StackPanel>
            </StackPanel>

            <!-- Generale -->
            <Border Style="{StaticResource SysCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="GENERALE" Style="{StaticResource SysHeading3}"/>
                    <ToggleSwitch x:Name="TogRestoreLastTab" Header="All'avvio ripristina l'ultima scheda"
                        OnContent="Sì" OffContent="No (sempre Dashboard)"/>
                    <TextBlock Text="Non disturbare — silenzia solo le notifiche proattive (disco, CPU, RAM, driver)."
                        Style="{StaticResource SysCaption}"/>
                    <TextBlock x:Name="TxtDndStatus" Text="Non disturbare: disattivo" FontFamily="Consolas"
                        FontSize="12" Foreground="{StaticResource SysAccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="30 min" Style="{StaticResource SysButtonSecondary}" Click="BtnDnd30_Click"/>
                        <Button Content="1 ora" Style="{StaticResource SysButtonSecondary}" Click="BtnDnd1h_Click"/>
                        <Button Content="4 ore" Style="{StaticResource SysButtonSecondary}" Click="BtnDnd4h_Click"/>
                        <Button Content="Disattiva" Style="{StaticResource SysButtonGhost}" Click="BtnDndOff_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notifiche -->
            <Border Style="{StaticResource SysCard}">
                <StackPanel Spacing="14">
                    <TextBlock Text="NOTIFICHE PROATTIVE" Style="{StaticResource SysHeading3}"/>
                    <ToggleSwitch x:Name="TogNotifyDisk" Header="Avvisa quando il disco è quasi pieno"
                        OnContent="Attivo" OffContent="Disattivo"/>
                    <TextBlock x:Name="LblDiskPct" FontFamily="Consolas" FontSize="11"
                        Foreground="{StaticResource SysTextSecondaryBrush}"/>
                    <Slider x:Name="SliderDisk" Minimum="70" Maximum="98" StepFrequency="1"/>
                    <ToggleSwitch x:Name="TogNotifyCpu" Header="Avvisa quando la CPU è alta a lungo (~15 s)"
                        OnContent="Attivo" OffContent="Disattivo"/>
                    <TextBlock x:Name="LblCpuPct" FontFamily="Consolas" FontSize="11"
                        Foreground="{StaticResource SysTextSecondaryBrush}"/>
                    <Slider x:Name="SliderCpu" Minimum="70" Maximum="99" StepFrequency="1"/>
                    <ToggleSwitch x:Name="TogNotifyRam" Header="Avvisa quando la RAM usata è alta a lungo (~15 s)"
                        OnContent="Attivo" OffContent="Disattivo"/>
                    <TextBlock x:Name="LblRamPct" FontFamily="Consolas" FontSize="11"
                        Foreground="{StaticResource SysTextSecondaryBrush}"/>
                    <Slider x:Name="SliderRam" Minimum="70" Maximum="95" StepFrequency="1"/>
                    <ToggleSwitch x:Name="TogNotifyDriver" Header="Avvisa se ci sono driver problematici"
                        OnContent="Attivo" OffContent="Disattivo"/>
                </StackPanel>
            </Border>

            <!-- Boost -->
            <Border Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="ONE-CLICK BOOST (DASHBOARD)" Style="{StaticResource SysHeading3}"/>
                    <TextBlock Text="Scegli cosa include la pulizia rapida."
                        Style="{StaticResource SysCaption}"/>
                    <ToggleSwitch x:Name="TogBoostTemp" Header="File temporanei (temp utente)"
                        OnContent="Sì" OffContent="No"/>
                    <ToggleSwitch x:Name="TogBoostThumb" Header="Cache miniature"
                        OnContent="Sì" OffContent="No"/>
                    <ToggleSwitch x:Name="TogBoostBrowser" Header="Cache browser rilevati"
                        OnContent="Sì" OffContent="No"/>
                    <ToggleSwitch x:Name="TogBoostKill" Header="Chiudi processi non in risposta (non di sistema)"
                        OnContent="Sì" OffContent="No"/>
                </StackPanel>
            </Border>

            <!-- Dati & info -->
            <Border Style="{StaticResource SysCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="DATI LOCALI" Style="{StaticResource SysHeading3}"/>
                    <TextBlock x:Name="TxtSettingsPath" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                        Foreground="{StaticResource SysTextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apri cartella" Style="{StaticResource SysButtonSecondary}" Click="BtnOpenFolder_Click"/>
                        <Button Content="Cancella cronologia boost/scan" Style="{StaticResource SysButtonGhost}"
                            Click="BtnClearHistory_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAbout" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                        Foreground="{StaticResource SysTextMutedBrush}"/>
                </StackPanel>
            </Border>

            <Button Content="Salva modifiche" Style="{StaticResource SysButtonPrimary}" HorizontalAlignment="Left"
                Click="BtnSave_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
