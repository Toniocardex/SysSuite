<UserControl
    x:Class="SysSuite.Views.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <StackPanel Spacing="10">
        <Border Style="{StaticResource SysCard}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="TELEMETRIA E TRACCIAMENTO" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                        IsActive="{Binding IsTelemetrySectionBusy}"
                        Visibility="{Binding TelemetryRingVisibility}"/>
                </StackPanel>
                <TextBlock Text="Le modifiche a Telemetria, Cronologia e Cortana richiedono privilegi admin."
                    Style="{StaticResource SysCaption}" TextWrapping="Wrap"/>
                <ToggleSwitch Header="Telemetria Microsoft"
                    OnContent="Attiva" OffContent="Disabilitata"
                    IsOn="{Binding IsTelemetryOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
                <ToggleSwitch Header="ID Pubblicità"
                    OnContent="Attivo" OffContent="Disabilitato"
                    IsOn="{Binding IsAdIdOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
                <ToggleSwitch Header="Cronologia attività"
                    OnContent="Attiva" OffContent="Disabilitata"
                    IsOn="{Binding IsActivityOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SysCard}">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="ASSISTENTI E SUGGERIMENTI" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <ProgressRing Width="22" Height="22" VerticalAlignment="Center"
                        IsActive="{Binding IsAssistSectionBusy}"
                        Visibility="{Binding AssistRingVisibility}"/>
                </StackPanel>
                <ToggleSwitch Header="Cortana"
                    OnContent="Attiva" OffContent="Disabilitata"
                    IsOn="{Binding IsCortanaOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
                <ToggleSwitch Header="Suggerimenti nel menu Start"
                    OnContent="Attivi" OffContent="Disabilitati"
                    IsOn="{Binding IsStartSuggOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
                <ToggleSwitch Header="Suggerimenti schermata di blocco"
                    OnContent="Attivi" OffContent="Disabilitati"
                    IsOn="{Binding IsLockTipsOn, Mode=TwoWay}"
                    IsEnabled="{Binding ArePrivacyTogglesEnabled}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
