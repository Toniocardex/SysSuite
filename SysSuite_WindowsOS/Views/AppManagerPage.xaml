<Page
    x:Class="SysSuite.Views.AppManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titolo -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Processi e App" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Avvio automatico, app installate e inutilizzate."
                Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="App all avvio" Style="{StaticResource SysButtonSecondary}"
                        Click="BtnStartup_Click"/>
                    <Button Content="App installate" Style="{StaticResource SysButtonSecondary}"
                        Click="BtnInstalled_Click"/>
                    <Button Content="App inutilizzate (90+ gg)" Style="{StaticResource SysButtonSecondary}"
                        Click="BtnUnused_Click"/>
                    <Button Content="Disabilita avvio selezionato" Style="{StaticResource SysButtonDanger}"
                        Click="BtnDisable_Click"/>
                    <TextBox x:Name="TxtSearch" PlaceholderText="Cerca..."
                        Style="{StaticResource SysTextBox}" Width="180"
                        TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>
                <TextBlock x:Name="TxtCount" Text="Seleziona una vista per iniziare."
                    Style="{StaticResource SysCaption}"/>
            </StackPanel>
        </Border>

        <!-- Lista con intestazioni dinamiche -->
        <Border Grid.Row="2" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Intestazioni colonne — aggiornate dal codice -->
                <Grid Grid.Row="0" Margin="12,0,12,8" x:Name="GridHeaders">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtH0" Grid.Column="0" Text="NOME"
                        Style="{StaticResource SysHeading3}"/>
                    <TextBlock x:Name="TxtH1" Grid.Column="1" Text=""
                        Style="{StaticResource SysHeading3}"/>
                    <TextBlock x:Name="TxtH2" Grid.Column="2" Text=""
                        Style="{StaticResource SysHeading3}"/>
                </Grid>

                <ListView x:Name="LvItems" Grid.Row="1"
                    Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Col0}"
                                    FontFamily="Consolas" FontSize="12"
                                    Foreground="#ECF0F8" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Col1}"
                                    FontFamily="Consolas" FontSize="11" Foreground="#7A8BA8"/>
                                <TextBlock Grid.Column="2" Text="{Binding Col2}"
                                    FontFamily="Consolas" FontSize="11"
                                    Foreground="#3D4D66" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>