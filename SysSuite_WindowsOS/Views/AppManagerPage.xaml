<Page
    x:Class="SysSuite.Views.AppManagerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1200" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Processi e App" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Avvio automatico, app installate e inutilizzate."
                Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="App all avvio" Style="{StaticResource SysButtonSecondary}"
                        Command="{Binding LoadStartupCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="App installate" Style="{StaticResource SysButtonSecondary}"
                        Command="{Binding LoadInstalledCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="App inutilizzate (90+ gg)" Style="{StaticResource SysButtonSecondary}"
                        Command="{Binding LoadUnusedCommand}"
                        IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Disabilita avvio selezionato" Style="{StaticResource SysButtonDanger}"
                        Click="BtnDisable_Click"
                        IsEnabled="{Binding IsNotBusy}"/>
                    <TextBox x:Name="TxtSearch" PlaceholderText="Cerca..."
                        Style="{StaticResource SysTextBox}" Width="180"
                        TextChanged="TxtSearch_TextChanged"
                        IsEnabled="{Binding IsNotBusy}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                    Style="{StaticResource SysCaption}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Header0}"
                        Style="{StaticResource SysHeading3}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Header1}"
                        Style="{StaticResource SysHeading3}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Header2}"
                        Style="{StaticResource SysHeading3}"/>
                    <TextBlock Grid.Column="3" Text=" "
                        Style="{StaticResource SysHeading3}" MinWidth="88"/>
                </Grid>

                <ListView x:Name="LvItems" Grid.Row="1"
                    Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding Items}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Col0}"
                                    FontFamily="Consolas" FontSize="12"
                                    Foreground="#ECF0F8" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Col1}"
                                    FontFamily="Consolas" FontSize="11" Foreground="#7A8BA8"/>
                                <TextBlock Grid.Column="2" Text="{Binding Col2}"
                                    FontFamily="Consolas" FontSize="11"
                                    Foreground="#3D4D66" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="3" Content="Disinstalla"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SysButtonDanger}"
                                    MinWidth="88"
                                    Visibility="{Binding UninstallButtonVisibility}"
                                    IsEnabled="{Binding DataContext.IsNotBusy, ElementName=RootPage}"
                                    Command="{Binding DataContext.UninstallCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
