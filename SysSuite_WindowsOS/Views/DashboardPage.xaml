<Page
    x:Class="SysSuite.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="#0F111A">

    <Page.Resources>
        <SolidColorBrush x:Key="DashCardBg" Color="#1C1F2B"/>
        <SolidColorBrush x:Key="DashCardBorder" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="DashCyanAccent" Color="#22D3EE"/>
        <SolidColorBrush x:Key="DashStorageBorder" Color="#4034D399"/>

        <Style x:Key="DashCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DashCardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SysHeading2}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DashMetricHugeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="32"/>
        </Style>

        <Style x:Key="DashProgressBarBoostStyle" TargetType="ProgressBar" BasedOn="{StaticResource SysProgressBar}">
            <Setter Property="Foreground" Value="#00D4A0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="DashModuleTileBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1F2B"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,18"/>
            <Setter Property="MinHeight" Value="128"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,24,32,8" Spacing="14" Orientation="Horizontal"
            VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Brand/Logo256.png" Width="44" Height="44"
                Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" Style="{StaticResource SysHeading1}"/>
                <TextBlock Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}" Style="{StaticResource SysBodyText}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <ProgressRing Width="52" Height="52" IsActive="True" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoadingRingVisibility, Mode=OneWay}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.MainContentVisibility, Mode=OneWay}">
                <StackPanel Padding="32,0,32,28" Spacing="24" MaxWidth="1100" HorizontalAlignment="Center">

                    <Grid MaxWidth="1180" HorizontalAlignment="Center" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Riga 1: Sistema operativo | Processore | Memoria RAM -->
                        <Grid Grid.Row="0" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DashCardBorderStyle}" Margin="10" MinHeight="220">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                            Foreground="{StaticResource SysBlueBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sistema operativo" Style="{StaticResource DashCardTitleStyle}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.OsNameText, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SysTextPrimaryBrush}"
                                        TextWrapping="Wrap" LineHeight="24"/>
                                    <TextBlock Text="{x:Bind ViewModel.OsVersionText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                        TextWrapping="Wrap" LineHeight="18"/>
                                    <StackPanel Spacing="6" Margin="0,8,0,0">
                                        <TextBlock Text="UPTIME" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.LiveUptimeText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="13" Foreground="{StaticResource SysTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="IP LOCALE" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SnapshotLocalIpText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="13" Foreground="{StaticResource SysAccentBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource DashCardBorderStyle}" Margin="10" MinHeight="220">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" VerticalAlignment="Stretch"
                                        Background="{StaticResource DashCyanAccent}" Opacity="0.85" Margin="0,4,0,4"/>
                                    <StackPanel Grid.Column="1" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                                Foreground="{StaticResource DashCyanAccent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Processore" Style="{StaticResource DashCardTitleStyle}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.DashboardCpuName, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DashCyanAccent}"
                                            TextWrapping="Wrap" LineHeight="22"/>
                                        <TextBlock Text="{x:Bind ViewModel.DashboardCpuCoresLine, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"
                                            LineHeight="20"/>
                                        <TextBlock Text="{x:Bind ViewModel.DashboardCpuFreqLine, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysTextMutedBrush}" TextWrapping="Wrap"
                                            Margin="0,2,0,0"/>
                                        <StackPanel Spacing="6" Margin="0,6,0,0">
                                            <TextBlock Text="SCHEDA MADRE" Style="{StaticResource SysHeading3}"/>
                                            <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.Motherboard, Mode=OneWay}" FontFamily="Consolas"
                                                FontSize="11" Foreground="{StaticResource SysTextPrimaryBrush}" TextWrapping="Wrap"
                                                LineHeight="18"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource DashCardBorderStyle}" Margin="10" MinHeight="220">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                                        <ProgressRing Width="76" Height="76"
                                            IsIndeterminate="False"
                                            Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.RamUsedPercentValue, Mode=OneWay}"
                                            Foreground="#A78BFA"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="&#xE964;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                                Foreground="#A78BFA" VerticalAlignment="Center"/>
                                            <TextBlock Text="Memoria RAM" Style="{StaticResource DashCardTitleStyle}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.Ram, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="#A78BFA" TextWrapping="Wrap"
                                            LineHeight="18" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.RamCommercialText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource DashMetricHugeStyle}" Foreground="#A78BFA"
                                            Text="{x:Bind ViewModel.RamUsedPercentText, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.RamDetailText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Riga 2: Archiviazione | Scheda video -->
                        <Grid Grid.Row="1" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DashCardBorderStyle}" Margin="10" MinHeight="240"
                                BorderBrush="{StaticResource DashStorageBorder}">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                                        <lvc:PieChart Series="{Binding DiskDonutSeries, Mode=OneWay}"
                                            Width="112" Height="112" InitialRotation="-90" MaxAngle="360"
                                            LegendPosition="Hidden" TooltipPosition="Hidden"/>
                                        <ProgressRing Width="56" Height="56"
                                            IsIndeterminate="False"
                                            Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.DiskUsedPercentValue, Mode=OneWay}"
                                            Foreground="{StaticResource SysGreenBrush}"/>
                                        <TextBlock Text="Agg. 30s" Style="{StaticResource SysCaption}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                                Foreground="{StaticResource SysGreenBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Archiviazione" Style="{StaticResource DashCardTitleStyle}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.SystemDiskModel, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysGreenBrush}" TextWrapping="Wrap"
                                            LineHeight="18" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource DashMetricHugeStyle}" Foreground="{StaticResource SysGreenBrush}"
                                            Text="{x:Bind ViewModel.DiskFreeText, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DiskTotalText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                            TextWrapping="Wrap" LineHeight="18"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <FontIcon Glyph="&#xE9CA;" FontSize="14"
                                                Foreground="{StaticResource SysGreenBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.DiskTemperature, Mode=OneWay}" FontFamily="Consolas"
                                                FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE8C5;" FontSize="14"
                                                Foreground="{StaticResource SysGreenBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.DiskHealth, Mode=OneWay}" FontFamily="Consolas"
                                                FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}"
                                                TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource DashCardBorderStyle}" Margin="10" MinHeight="240">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <ProgressRing Width="76" Height="76"
                                            IsIndeterminate="False"
                                            Minimum="0" Maximum="100"
                                            Value="{x:Bind ViewModel.GpuUsagePercentValue, Mode=OneWay}"
                                            Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                                Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Scheda video" Style="{StaticResource DashCardTitleStyle}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.GpuModel, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="12" Foreground="{StaticResource SysPurpleBrush}" TextWrapping="Wrap"
                                            LineHeight="20"/>
                                        <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.DisplayText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"
                                            LineHeight="18"/>
                                        <StackPanel Spacing="6" Margin="0,4,0,0">
                                            <TextBlock Text="UTILIZZO GPU (DXGI)" Style="{StaticResource SysHeading3}"/>
                                            <TextBlock Style="{StaticResource DashMetricHugeStyle}"
                                                Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}"
                                                Text="{x:Bind ViewModel.GpuUsagePercentage, Mode=OneWay}"/>
                                            <TextBlock Text="VRAM" Style="{StaticResource SysHeading3}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{x:Bind ViewModel.GpuUsedVram, Mode=OneWay}" FontFamily="Consolas"
                                                FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource SysProgressBar}" Minimum="0" Maximum="100"
                                            Margin="0,4,0,0" Height="6" CornerRadius="3"
                                            Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.GpuUsagePercentValue, Mode=OneWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <StackPanel Spacing="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource DashCardBorderStyle}" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons"
                                                    FontSize="18" Foreground="#00D4A0" VerticalAlignment="Center"/>
                                                <TextBlock Text="One-Click Boost" Style="{StaticResource DashCardTitleStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="Temp, miniature, cache browser, processi bloccati."
                                                Style="{StaticResource SysCaption}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                <ProgressBar Style="{StaticResource DashProgressBarBoostStyle}"
                                                    Width="180" Minimum="0" Maximum="100"
                                                    Visibility="{x:Bind ViewModel.BoostProgressVisibility, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ViewModel.BoostProgressIndeterminate, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.BoostProgressValue, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind ViewModel.BoostResultText, Mode=OneWay}"
                                                    Style="{StaticResource SysAccentText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="BOOST"
                                            Style="{StaticResource SysButtonPrimary}" FontSize="14"
                                            Padding="22,12" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.RunOneClickBoostCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsOneClickBoostEnabled, Mode=OneWay}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DashCardBorderStyle}"
                                    BorderBrush="#383B9EFF" BorderThickness="1" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons"
                                                    FontSize="18" Foreground="#3B9EFF" VerticalAlignment="Center"/>
                                                <TextBlock Text="RAM Optimizer" Style="{StaticResource DashCardTitleStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.RamOptimizerStatusText, Mode=OneWay}"
                                                Style="{StaticResource SysCaption}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                                <ProgressBar Style="{StaticResource SysProgressBar}"
                                                    Width="180" Height="6" CornerRadius="3" Foreground="#3B9EFF"
                                                    Visibility="{x:Bind ViewModel.RamOptimizerProgressVisibility, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ViewModel.RamOptimizerProgressIndeterminate, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind ViewModel.RamOptimizerResultText, Mode=OneWay}"
                                                    FontFamily="Consolas" FontSize="11" Foreground="#3B9EFF"
                                                    VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="OTTIMIZZA"
                                            Style="{StaticResource SysButtonSecondary}" FontSize="12"
                                            Padding="16,12" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.RunRamOptimizerCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsRamOptimizerButtonEnabled, Mode=OneWay}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="MODULI DISPONIBILI" Style="{StaticResource SysHeading3}" Margin="0,4,0,0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="MainSuite"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#00D4A0"/>
                                            <TextBlock Text="Ottimizzazione" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Pulizia, SFC, privacy" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Monitor"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#22D3EE"/>
                                            <TextBlock Text="Monitor Live" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="CPU e RAM in tempo reale" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Disco"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#34D399"/>
                                            <TextBlock Text="Analisi Disco" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="File grandi e duplicati" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="3" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Gaming"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#A78BFA"/>
                                            <TextBlock Text="Gaming Mode" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="FPS e latenza ottimizzati" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="4" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="AppManager"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#34D399"/>
                                            <TextBlock Text="Processi e App" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Avvio automatico e gestione" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>

                            <Grid Margin="0,-6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Network"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#00D4A0"/>
                                            <TextBlock Text="Scanner Rete" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="DNS, TCP/IP, porte aperte" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Driver"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FFB547"/>
                                            <TextBlock Text="Driver" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Lista e backup con DISM" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Battery"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#34D399"/>
                                            <TextBlock Text="Batteria" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Salute, cicli e report" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="3" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Browser"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,12,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FF5A5A"/>
                                            <TextBlock Text="Pulizia Browser" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Chrome, Edge, Firefox, Brave" Style="{StaticResource SysCaption}"
