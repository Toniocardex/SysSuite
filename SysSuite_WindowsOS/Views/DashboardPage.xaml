                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="12">
                                    <Border Style="{StaticResource DashModuleTileBorderStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#A78BFA"/>
                                            <TextBlock Text="Registro" Style="{StaticResource DashCardTitleStyle}"/>
                                            <TextBlock Text="Chiavi orfane e backup" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
