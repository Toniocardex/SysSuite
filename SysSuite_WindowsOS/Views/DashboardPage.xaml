<Page
    x:Class="SysSuite.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="{StaticResource SysBGBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,24,32,8" Spacing="14" Orientation="Horizontal"
            VerticalAlignment="Center">
            <Image Source="ms-appx:///Assets/Brand/Logo256.png" Width="44" Height="44"
                Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" Style="{StaticResource SysHeading1}"/>
                <TextBlock Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}" Style="{StaticResource SysBodyText}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <ProgressRing Width="52" Height="52" IsActive="True" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.LoadingRingVisibility, Mode=OneWay}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.MainContentVisibility, Mode=OneWay}">
                <StackPanel Padding="32,0,32,24" Spacing="20" MaxWidth="1100" HorizontalAlignment="Center">

                    <Grid MaxWidth="1180" HorizontalAlignment="Center" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Riga 1: Sistema operativo | Processore | Memoria RAM -->
                        <Grid Grid.Row="0" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SysSurfaceBrush}"
                                BorderBrush="{StaticResource SysBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="10" Padding="16" MinHeight="200">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                            Foreground="{StaticResource SysBlueBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sistema operativo" Style="{StaticResource SysHeading2}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.OsNameText, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SysTextPrimaryBrush}"
                                        TextWrapping="Wrap" LineHeight="22"/>
                                    <TextBlock Text="{x:Bind ViewModel.OsVersionText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                        TextWrapping="Wrap" LineHeight="18"/>
                                    <StackPanel Spacing="4" Margin="0,6,0,0">
                                        <TextBlock Text="UPTIME" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.LiveUptimeText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="IP LOCALE" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SnapshotLocalIpText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="12" Foreground="{StaticResource SysAccentBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SysSurfaceBrush}"
                                BorderBrush="{StaticResource SysBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="10" Padding="16" MinHeight="200">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                            Foreground="{StaticResource SysAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Processore" Style="{StaticResource SysHeading2}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.DashboardCpuName, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SysAccentBrush}"
                                        TextWrapping="Wrap" LineHeight="22"/>
                                    <TextBlock Text="{x:Bind ViewModel.DashboardCpuCoresLine, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="12" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"
                                        LineHeight="20"/>
                                    <TextBlock Text="{x:Bind ViewModel.DashboardCpuFreqLine, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="11" Foreground="{StaticResource SysTextMutedBrush}" TextWrapping="Wrap"
                                        Margin="0,2,0,0"/>
                                    <StackPanel Spacing="4" Margin="0,8,0,0">
                                        <TextBlock Text="SCHEDA MADRE" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.Motherboard, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysTextPrimaryBrush}" TextWrapping="Wrap"
                                            LineHeight="18"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SysSurfaceBrush}"
                                BorderBrush="{StaticResource SysBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="10" Padding="16" MinHeight="200">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="&#xE964;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                            Foreground="{StaticResource SysBlueBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Memoria RAM" Style="{StaticResource SysHeading2}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.Ram, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="11" Foreground="{StaticResource SysBlueBrush}" TextWrapping="Wrap"
                                        LineHeight="18" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamCommercialText, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="11" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamUsedPercentText, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="22" FontWeight="Bold" Foreground="{StaticResource SysBlueBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamDetailText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                        TextWrapping="Wrap"/>
                                    <ProgressBar Style="{StaticResource SysProgressBar}" Minimum="0" Maximum="100"
                                        Margin="0,6,0,0"
                                        Value="{x:Bind ViewModel.RamUsedPercentValue, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Riga 2: Archiviazione (donut) | Scheda video -->
                        <Grid Grid.Row="1" ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SysSurfaceBrush}"
                                BorderBrush="{StaticResource SysBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="10" Padding="16" MinHeight="220">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8">
                                        <lvc:PieChart Series="{Binding DiskDonutSeries, Mode=OneWay}"
                                            Width="112" Height="112" InitialRotation="-90" MaxAngle="360"
                                            LegendPosition="Hidden" TooltipPosition="Hidden"/>
                                        <TextBlock Text="Agg. 30s" Style="{StaticResource SysCaption}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                                Foreground="{StaticResource SysAmberBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Archiviazione" Style="{StaticResource SysHeading2}"
                                                VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.SystemDiskModel, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="11" Foreground="{StaticResource SysAmberBrush}" TextWrapping="Wrap"
                                            LineHeight="18" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ViewModel.DiskFreeText, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="20" FontWeight="Bold" Foreground="{StaticResource SysAmberBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.DiskTotalText, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                            TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SysSurfaceBrush}"
                                BorderBrush="{StaticResource SysBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="8" Margin="10" Padding="16" MinHeight="220">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="24"
                                            Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Scheda video" Style="{StaticResource SysHeading2}"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.GpuModel, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="12" Foreground="{StaticResource SysPurpleBrush}" TextWrapping="Wrap"
                                        LineHeight="20"/>
                                    <TextBlock Text="{x:Bind ViewModel.HardwareSnapshot.DisplayText, Mode=OneWay}" FontFamily="Consolas"
                                        FontSize="11" Foreground="{StaticResource SysTextSecondaryBrush}" TextWrapping="Wrap"
                                        LineHeight="18"/>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="VRAM (DXGI)" Style="{StaticResource SysHeading3}"/>
                                        <TextBlock Text="{x:Bind ViewModel.GpuUsagePercentage, Mode=OneWay}" FontFamily="Consolas"
                                            FontSize="18" FontWeight="Bold" Foreground="{StaticResource SysPurpleBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.GpuUsedVram, Mode=OneWay}" Style="{StaticResource SysCaption}"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource SysProgressBar}" Minimum="0" Maximum="100"
                                        Margin="0,4,0,0"
                                        Foreground="{x:Bind ViewModel.GpuBrandBrush, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.GpuUsagePercentValue, Mode=OneWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid>
                        <StackPanel Spacing="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SysCardAccent}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons"
                                                    FontSize="18" Foreground="#00D4A0" VerticalAlignment="Center"/>
                                                <TextBlock Text="One-Click Boost" Style="{StaticResource SysHeading2}"/>
                                            </StackPanel>
                                            <TextBlock Text="Temp, miniature, cache browser, processi bloccati."
                                                Style="{StaticResource SysCaption}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <ProgressBar Style="{StaticResource SysProgressBar}"
                                                    Width="160" Minimum="0" Maximum="100"
                                                    Visibility="{x:Bind ViewModel.BoostProgressVisibility, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ViewModel.BoostProgressIndeterminate, Mode=OneWay}"
                                                    Value="{x:Bind ViewModel.BoostProgressValue, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind ViewModel.BoostResultText, Mode=OneWay}"
                                                    Style="{StaticResource SysAccentText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="BOOST"
                                            Style="{StaticResource SysButtonPrimary}" FontSize="14"
                                            Padding="22,12" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.RunOneClickBoostCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsOneClickBoostEnabled, Mode=OneWay}"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SysCard}"
                                    BorderBrush="#3B9EFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons"
                                                    FontSize="18" Foreground="#3B9EFF" VerticalAlignment="Center"/>
                                                <TextBlock Text="RAM Optimizer" Style="{StaticResource SysHeading2}"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.RamOptimizerStatusText, Mode=OneWay}"
                                                Style="{StaticResource SysCaption}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <ProgressBar Style="{StaticResource SysProgressBar}"
                                                    Width="160"
                                                    Visibility="{x:Bind ViewModel.RamOptimizerProgressVisibility, Mode=OneWay}"
                                                    IsIndeterminate="{x:Bind ViewModel.RamOptimizerProgressIndeterminate, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind ViewModel.RamOptimizerResultText, Mode=OneWay}"
                                                    FontFamily="Consolas" FontSize="11" Foreground="#3B9EFF"
                                                    VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="OTTIMIZZA"
                                            Style="{StaticResource SysButtonSecondary}" FontSize="12"
                                            Padding="16,12" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.RunRamOptimizerCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsRamOptimizerButtonEnabled, Mode=OneWay}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBlock Text="MODULI DISPONIBILI" Style="{StaticResource SysHeading3}" Margin="0,8,0,0"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="MainSuite"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,10"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#00D4A0"/>
                                            <TextBlock Text="Ottimizzazione" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Pulizia, SFC, privacy" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Monitor"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,10"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#3B9EFF"/>
                                            <TextBlock Text="Monitor Live" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="CPU e RAM in tempo reale" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Disco"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,10"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FFB547"/>
                                            <TextBlock Text="Analisi Disco" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="File grandi e duplicati" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="3" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Gaming"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,10"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#A78BFA"/>
                                            <TextBlock Text="Gaming Mode" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="FPS e latenza ottimizzati" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="4" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="AppManager"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,0,10"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#34D399"/>
                                            <TextBlock Text="Processi e App" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Avvio automatico e gestione" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>

                            <Grid Margin="0,-10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Network"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#00D4A0"/>
                                            <TextBlock Text="Scanner Rete" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="DNS, TCP/IP, porte aperte" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Driver"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FFB547"/>
                                            <TextBlock Text="Driver" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Lista e backup con DISM" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="2" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Battery"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE83F;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#34D399"/>
                                            <TextBlock Text="Batteria" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Salute, cicli e report" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="3" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Browser"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,10,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#FF5A5A"/>
                                            <TextBlock Text="Pulizia Browser" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Chrome, Edge, Firefox, Brave" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>

                                <Button Grid.Column="4" Command="{x:Bind ViewModel.NavigateToModuleCommand}" CommandParameter="Registry"
                                    Style="{StaticResource SysButtonGhost}" Padding="0" Margin="0,0,0,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border Style="{StaticResource SysCard}" HorizontalAlignment="Stretch" MinHeight="120">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="#A78BFA"/>
                                            <TextBlock Text="Registro" Style="{StaticResource SysHeading2}"/>
                                            <TextBlock Text="Chiavi orfane e backup" Style="{StaticResource SysCaption}"
                                                MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
