<Page
    x:Class="SysSuite.Views.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Pulizia Browser" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Rileva i browser installati e rimuove cache, cookie tecnici e shader cache." Style="{StaticResource SysBodyText}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="BROWSER RILEVATI" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Rileva browser" Style="{StaticResource SysButtonSecondary}" Click="BtnDetect_Click"/>
                    <Button Content="Pulisci cache" Style="{StaticResource SysButtonPrimary}" Click="BtnCleanAll_Click"/>
                    <Button Content="Pulisci tutto (cache+shader)" Style="{StaticResource SysButtonSecondary}" Click="BtnCleanDeep_Click"/>
                </StackPanel>
                <ListView x:Name="LvBrowsers" MaxHeight="200" Background="Transparent" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="13" Foreground="#ECF0F8" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding InstalledText}" FontFamily="Consolas" FontSize="11" Foreground="{Binding InstalledColor}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CacheSize}" FontFamily="Consolas" FontSize="11" Foreground="#FFB547" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding CachePath}" FontFamily="Consolas" FontSize="10" Foreground="#3D4D66" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="LOG" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Pulisci" Style="{StaticResource SysButtonGhost}" Click="BtnClear_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8" TextWrapping="Wrap"
                        Text="Clicca 'Rileva browser' per iniziare."/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>