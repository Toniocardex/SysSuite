<Page
    x:Class="SysSuite.Views.RegistryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Analisi Registro" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Scansione riferimenti orfani nel registro di sistema. Modalità sola lettura."
                Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <!-- Avviso informativo -->
        <Border Grid.Row="1" Background="#FFB54712" BorderBrush="#FFB54740" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="16"
                    Foreground="#FFB547" VerticalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#FFB547"
                    Text="I riferimenti orfani nel registro raramente causano problemi di prestazioni. Microsoft sconsiglia la pulizia automatica del registro. Questa sezione è solo informativa — usa il backup per sicurezza prima di qualsiasi modifica manuale."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SysCard}" Margin="0,0,0,14">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BtnScanRegistry" Content="Scansiona registro" Style="{StaticResource SysButtonPrimary}" Click="BtnScan_Click"
                        ToolTipService.ToolTip="Cerca riferimenti a file .dll/.exe non più presenti sul disco. Solo lettura."/>
                    <Button x:Name="BtnBackupRegistry" Content="Backup registro (Desktop)" Style="{StaticResource SysButtonSecondary}" Click="BtnBackup_Click"
                        ToolTipService.ToolTip="Esporta HKLM in un file .reg sul Desktop. Richiede admin."/>
                    <Button x:Name="BtnOpenRegedit" Content="Apri Editor del Registro" Style="{StaticResource SysButtonGhost}" Click="BtnOpenRegedit_Click"
                        ToolTipService.ToolTip="Apre regedit.exe per modifiche manuali avanzate."/>
                    <ProgressRing x:Name="BusyRing" Width="28" Height="28" IsActive="True" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbScan" Style="{StaticResource SysProgressBar}" Width="160" VerticalAlignment="Center" Maximum="100" IsIndeterminate="False"/>
                    <TextBlock x:Name="TxtCount" Text="" Style="{StaticResource SysCaption}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource SysCard}">
            <ListView x:Name="LvIssues" Background="Transparent" BorderThickness="0" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Category}" FontFamily="Consolas" FontSize="11" Foreground="#FFB547"/>
                            <TextBlock Grid.Column="1" Text="{Binding KeyPath}" FontFamily="Consolas" FontSize="11" Foreground="#7A8BA8" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding Description}" FontFamily="Consolas" FontSize="11" Foreground="#ECF0F8" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
