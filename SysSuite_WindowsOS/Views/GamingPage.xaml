<Page
    x:Class="SysSuite.Views.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Gaming Mode" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Massimizza FPS, riduce latenza, ferma i servizi non necessari." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <!-- Stato + pulsanti -->
        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#FF5A5A" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Gaming Mode INATTIVA" FontFamily="Consolas"
                            FontSize="16" FontWeight="Bold" Foreground="#ECF0F8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Attivando: piano Ultimate Performance, HAGS, Nagle off, servizi Xbox sospesi, aggiornamenti sospesi." 
                        Style="{StaticResource SysCaption}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="BtnActivate" Content="ATTIVA" Style="{StaticResource SysButtonPrimary}" Click="BtnActivate_Click" MinWidth="120"
                        ToolTipService.ToolTip="Attiva piano Ultimate Performance, HAGS, disabilita Nagle, ferma servizi Xbox e aggiornamenti. Richiede admin."/>
                    <Button x:Name="BtnDeactivate" Content="DISATTIVA" Style="{StaticResource SysButtonSecondary}" Click="BtnDeactivate_Click" MinWidth="120" IsEnabled="False"
                        ToolTipService.ToolTip="Ripristina piano bilanciato, riattiva Nagle e servizi Xbox. Richiede admin."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log operazioni -->
        <Border Grid.Row="2" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="LOG OPERAZIONI" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Pulisci" Style="{StaticResource SysButtonGhost}" Click="BtnClearLog_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8"
                        TextWrapping="Wrap" Text="Pronto. Usa i pulsanti sopra per attivare o disattivare Gaming Mode."/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>