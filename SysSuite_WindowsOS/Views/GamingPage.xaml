<Page
    x:Class="SysSuite.Views.GamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SysBGBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Padding="32,24" MaxWidth="1100" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Gaming Mode" Style="{StaticResource SysHeading1}"/>
            <TextBlock Text="Massimizza FPS, riduce latenza, ferma i servizi non necessari." Style="{StaticResource SysBodyText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SysCard}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Width="12" Height="12" Fill="{Binding StatusDotFill}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusHeadline}" FontFamily="Consolas"
                            FontSize="16" FontWeight="Bold" Foreground="#ECF0F8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Attivando: piano Ultimate Performance, HAGS, Nagle off, servizi Xbox sospesi, aggiornamenti sospesi."
                        Style="{StaticResource SysCaption}" TextWrapping="Wrap"/>
                    <Button Content="Ottimizza" Style="{StaticResource SysButtonSecondary}" MinWidth="140"
                        HorizontalAlignment="Left"
                        Command="{Binding OptimizePowerCommand}"
                        IsEnabled="{Binding IsOptimizePowerButtonEnabled}"
                        ToolTipService.ToolTip="Sblocca potenza: duplica Ultimate Performance, attiva il piano, azzera core parking nel registro (richiede Admin)."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing Width="32" Height="32" IsActive="{Binding IsBusy}" Visibility="{Binding BusyRingVisibility}"/>
                    <Button Content="ATTIVA" Style="{StaticResource SysButtonPrimary}" MinWidth="120"
                        Command="{Binding ActivateCommand}"
                        IsEnabled="{Binding IsActivateButtonEnabled}"
                        ToolTipService.ToolTip="Attiva piano Ultimate Performance, HAGS, disabilita Nagle, ferma servizi Xbox e aggiornamenti. Richiede admin."/>
                    <Button Content="DISATTIVA" Style="{StaticResource SysButtonSecondary}" MinWidth="120"
                        Command="{Binding DeactivateCommand}"
                        IsEnabled="{Binding IsDeactivateButtonEnabled}"
                        ToolTipService.ToolTip="Ripristina piano bilanciato, riattiva Nagle e servizi Xbox. Richiede admin."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SysCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <TextBlock Text="LOG OPERAZIONI" Style="{StaticResource SysHeading3}" VerticalAlignment="Center"/>
                    <Button Content="Pulisci" Style="{StaticResource SysButtonGhost}" Command="{Binding ClearLogCommand}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="Transparent">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copia log" Click="LogCopyMenu_Click">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Copy"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#7A8BA8"
                            TextWrapping="Wrap" Text="{Binding LogText}" IsTextSelectionEnabled="True"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
